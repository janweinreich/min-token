# Pioneer serves lean, strong and pioneer/auto on one Anthropic-compatible API.
# Inference requires a billing plan; without one you get 403 card_required.
PIONEER_API_KEY=

# Optional overrides (defaults shown)
# PIONEER_BASE_URL=https://api.pioneer.ai/v1
# PIONEER_LEAN_MODEL=claude-haiku-4-5
# PIONEER_STRONG_MODEL=claude-sonnet-5

# Zero-config fallback: the same adapter with a different baseURL.
# ANTHROPIC_API_KEY=

# Set false to forbid model-weight downloads at runtime (after first prefetch).
# EMBEDDING_ALLOW_DOWNLOAD=true
