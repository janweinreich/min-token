{
  "mcpServers": {
    "band-mcp": {
      "command": "npx",
      "args": ["-y", "@band-ai/mcp"],
      "env": {
        "BAND_AGENT_KEY": "${env:BAND_AGENT_API_KEY}",
        "BAND_USER_KEY": "${env:BAND_USER_API_KEY}"
      }
    },
    "loopqa": {
      "url": "https://qa.replay.io/api/mcp",
      "headers": {
        "Authorization": "Bearer ${env:REPLAY_API_KEY}"
      }
    }
  }
}
